{
    "name": "alto/importmap",
    "description": "Manage render and resolve Import Maps - Support scopes, integrity hashes, and WICG-compliant resolution.",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "importmap",
        "javascript",
        "modules",
        "esm",
        "assets",
        "html",
        "renderer",
        "wicg",
        "php"
    ],
    "authors": [
        {
            "name": "Simon André",
            "email": "smn.andre@gmail.com"
        }
    ],
    "homepage": "https://altophp.com/importmap",
    "support": {
        "issues": "https://github.com/altophp/importmap/issues",
        "source": "https://github.com/altophp/importmap",
        "docs": "https://altophp.com/importmap"
    },
    "funding": [
        {
            "type": "github",
            "url": "https://github.com/sponsors/smnandre"
        }
    ],
    "require": {
        "php": ">=8.3"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.0",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "Alto\\ImportMap\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Alto\\ImportMap\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "cs": "vendor/bin/php-cs-fixer fix --dry-run --diff --sequential",
        "cs:fix": "vendor/bin/php-cs-fixer fix --sequential",
        "qa": [
            "@cs",
            "@sa",
            "@test"
        ],
        "sa": "vendor/bin/phpstan analyse --memory-limit=-1",
        "test": "vendor/bin/phpunit"
    }
}
